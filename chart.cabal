-- Initial chart.cabal generated by cabal init.  For further documentation,
--  see http://haskell.org/cabal/users-guide/

-- The name of the package.
name:                chart

-- The package version.  See the Haskell package versioning policy (PVP)
-- for standards guiding when and how versions should be incremented.
-- https://wiki.haskell.org/Package_versioning_policy
-- PVP summary:      +-+------- breaking API changes
--                   | | +----- non-breaking API additions
--                   | | | +--- code changes with no API change
version:             0.1.0.0

-- A short (one-line) description of the package.
synopsis:            Print a colorized ASCII chart

-- A longer description of the package.
description:
        Print a chart of all 128 ASCII characters to stderr.
        Assumes that the terminal supports ANSI color escapes.

-- The license under which the package is released.
license:             BSD3

-- The file containing the license text.
license-file:        LICENSE

-- The package author(s).
author:              Mignon Pelletier

-- An email address to which users can send suggestions, bug reports, and
-- patches.
maintainer:          code@funwithsoftware.org

homepage:            https://github.com/mignon-p/hs-ascii-chart

bug-reports:         https://github.com/mignon-p/hs-ascii-chart/issues

-- A copyright notice.
copyright:           © Mignon Pelletier, 2024-2025

category:            Development

build-type:          Simple

-- Extra files to be distributed with the package, such as examples or a
-- README.
extra-source-files:  CHANGELOG.md
                   , README.md
                   , doc/screenshot.png

-- Constraint on the version of Cabal needed to build this package.
cabal-version:       >=1.10

tested-with:         GHC==9.6.7
                   , GHC==9.10.2

source-repository head
  Type:     git
  Location: https://github.com/mignon-p/hs-ascii-chart.git


executable chart
  -- .hs or .lhs file containing the Main module.
  main-is:             chart.hs

  -- Modules included in this executable, other than Main.
  -- other-modules:

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:

  -- Other library packages from which modules are imported.
  build-depends:       base    >= 4.12    && < 5

  -- Directories containing source files.
  -- hs-source-dirs:

  -- Base language which the package is written in.
  default-language:    Haskell2010

  ghc-options:         -Wall
